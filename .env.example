# Only needed for TTS playback (POST /speak). Get key at platform.openai.com
OPENAI_API_KEY=your_key_here

# Optional — used for cheaper WhatsApp analysis (falls back to Claude if absent)
GEMINI_API_KEY=your_key_here

# Spotify app credentials — developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Dropbox app credentials — dropbox.com/developers/apps → your app → Settings
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
